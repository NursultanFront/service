# Environment variables of the services in this repository, with their in-code defaults.
# Copy to .env (gitignored) and adjust. Every variable can also be passed as a --flag.
# The defaults use docker-compose service names; for `go run` against the compose
# stack see AGENTS.md (Local Development Workflow), e.g. SALES_DB_HOST=localhost:5432.
# Masked values (passwords, keys) are left empty here: never commit real secrets.
#
# NOTE(AI): generated from `go run ./cmd/<svc> --help` in migration step (c).

# --- sales -------------------------------------------------------
SALES_AUTH_GRPC_HOST=auth-service:6001
SALES_AUTH_HOST=http://auth-service:6000
SALES_AUTH_MECHANISM=http
SALES_DB_DISABLE_TLS=true
SALES_DB_HOST=database-service
SALES_DB_MAX_IDLE_CONNS=0
SALES_DB_MAX_OPEN_CONNS=0
SALES_DB_NAME=postgres
SALES_DB_PASSWORD=
SALES_DB_USER=postgres
SALES_REDIS_DB=0
SALES_REDIS_HOST=redis:6379
SALES_REDIS_PASSWORD=
SALES_TEMPO_HOST=tempo:4317
SALES_TEMPO_PROBABILITY=0.05
SALES_TEMPO_SERVICE_NAME=sales
SALES_WEB_API_HOST=0.0.0.0:3000
SALES_WEB_CORS_ALLOWED_ORIGINS=*
SALES_WEB_DEBUG_HOST=0.0.0.0:3010
SALES_WEB_IDLE_TIMEOUT=120s
SALES_WEB_READ_TIMEOUT=5s
SALES_WEB_SHUTDOWN_TIMEOUT=20s
SALES_WEB_WRITE_TIMEOUT=10s

# --- auth --------------------------------------------------------
AUTH_AUTH_ACTIVE_KID=54bb2165-71e1-41a6-af3e-7da4a0e1e2c1
AUTH_AUTH_ISSUER=service project
AUTH_AUTH_KEYS_FOLDER=deploy/keys/
AUTH_AUTH_KEYS_JSON=
AUTH_DB_DISABLE_TLS=true
AUTH_DB_HOST=database-service
AUTH_DB_MAX_IDLE_CONNS=0
AUTH_DB_MAX_OPEN_CONNS=0
AUTH_DB_NAME=postgres
AUTH_DB_PASSWORD=
AUTH_DB_USER=postgres
AUTH_REDIS_DB=0
AUTH_REDIS_HOST=redis:6379
AUTH_REDIS_PASSWORD=
AUTH_TEMPO_HOST=tempo:4317
AUTH_TEMPO_PROBABILITY=0.05
AUTH_TEMPO_SERVICE_NAME=auth
AUTH_WEB_API_HOST=0.0.0.0:6000
AUTH_WEB_CORS_ALLOWED_ORIGINS=*
AUTH_WEB_DEBUG_HOST=0.0.0.0:6010
AUTH_WEB_GRPC_HOST=0.0.0.0:6001
AUTH_WEB_IDLE_TIMEOUT=120s
AUTH_WEB_READ_TIMEOUT=5s
AUTH_WEB_SHUTDOWN_TIMEOUT=20s
AUTH_WEB_WRITE_TIMEOUT=10s

# --- metrics -----------------------------------------------------
METRICS_COLLECT_FROM=http://localhost:3010/debug/vars
METRICS_EXPVAR_HOST=0.0.0.0:4000
METRICS_EXPVAR_IDLE_TIMEOUT=120s
METRICS_EXPVAR_READ_TIMEOUT=5s
METRICS_EXPVAR_ROUTE=/metrics
METRICS_EXPVAR_SHUTDOWN_TIMEOUT=5s
METRICS_EXPVAR_WRITE_TIMEOUT=10s
METRICS_PROMETHEUS_HOST=0.0.0.0:4020
METRICS_PROMETHEUS_IDLE_TIMEOUT=120s
METRICS_PROMETHEUS_READ_TIMEOUT=5s
METRICS_PROMETHEUS_ROUTE=/metrics
METRICS_PROMETHEUS_SHUTDOWN_TIMEOUT=5s
METRICS_PROMETHEUS_WRITE_TIMEOUT=10s
METRICS_PUBLISH_INTERVAL=5s
METRICS_PUBLISH_TO=console
METRICS_WEB_DEBUG_HOST=0.0.0.0:4010
